// =====================================================
// SPORTS RESERVATION
// =====================================================
class SportsReservation {

    private String reservationId;
    private SportsCustomer customer;
    private SportsGame game;
    private SportsSeat seat;
    private boolean active;

    public SportsReservation(
            String reservationId,
            SportsCustomer customer,
            SportsGame game,
            SportsSeat seat) {

        this.reservationId = reservationId;
        this.customer = customer;
        this.game = game;
        this.seat = seat;
        this.active = true;
    }

    public String getReservationId() {
        return reservationId;
    }

    public SportsCustomer getCustomer() {
        return customer;
    }

    public SportsGame getGame() {
        return game;
    }

    public SportsSeat getSeat() {
        return seat;
    }

    public boolean isActive() {
        return active;
    }

    public void cancel() {

        if (active) {
            active = false;
            seat.cancelReservation();
        }
    }

    public void displayTicket() {

        System.out.println();
        System.out.println("=========================================");
        System.out.println("             RESERVO SPORTS");
        System.out.println("=========================================");
        System.out.println("Reservation: " + reservationId);
        System.out.println("Status: " +
                (active ? "CONFIRMED" : "CANCELLED"));
        System.out.println();
        System.out.println(
                game.getAwayTeam().getFullName()
                + " @ "
                + game.getHomeTeam().getFullName()
        );
        System.out.println();
        System.out.println("Date: " + game.getDate());
        System.out.println("Time: " + game.getTime());
        System.out.println("Venue: " +
                game.getVenue().getName());
        System.out.println();
        System.out.println("Customer: " +
                customer.getName());
        System.out.println("Email: " +
                customer.getEmail());
        System.out.println();
        System.out.println("Section: " +
                seat.getSection());
        System.out.println("Seat: " +
                seat.getSeatNumber());

        System.out.printf(
                "Ticket Price: $%.2f%n",
                seat.getPrice()
        );

        System.out.println("=========================================");
    }
}



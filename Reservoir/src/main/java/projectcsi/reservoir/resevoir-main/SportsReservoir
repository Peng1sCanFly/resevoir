// =====================================================
// TEAM
// =====================================================
class Team {
    private String teamId;
    private String name;
    private String city;
    private String sport;
    private String league;

    public Team(String teamId, String name, String city,
                String sport, String league) {
        this.teamId = teamId;
        this.name = name;
        this.city = city;
        this.sport = sport;
        this.league = league;
    }

    public String getTeamId() {
        return teamId;
    }

    public String getName() {
        return name;
    }

    public String getCity() {
        return city;
    }

    public String getSport() {
        return sport;
    }

    public String getLeague() {
        return league;
    }

    public String getFullName() {
        return city + " " + name;
    }

    @Override
    public String toString() {
        return getFullName() + " | " + league + " | " + sport;
    }
}


// =====================================================
// VENUE
// =====================================================
class SportsVenue {
    private String venueId;
    private String name;
    private String city;
    private int capacity;

    public SportsVenue(String venueId, String name,
                       String city, int capacity) {
        this.venueId = venueId;
        this.name = name;
        this.city = city;
        this.capacity = capacity;
    }

    public String getName() {
        return name;
    }

    public String getCity() {
        return city;
    }

    public int getCapacity() {
        return capacity;
    }

    @Override
    public String toString() {
        return name + " - " + city +
                " | Capacity: " + capacity;
    }
}


// =====================================================
// SPORTS GAME
// =====================================================
class SportsGame {
    private String gameId;
    private Team homeTeam;
    private Team awayTeam;
    private SportsVenue venue;
    private String date;
    private String time;
    private List<SportsSeat> seats;

    public SportsGame(String gameId,
                      Team homeTeam,
                      Team awayTeam,
                      SportsVenue venue,
                      String date,
                      String time) {

        this.gameId = gameId;
        this.homeTeam = homeTeam;
        this.awayTeam = awayTeam;
        this.venue = venue;
        this.date = date;
        this.time = time;
        this.seats = new ArrayList<>();

        generateSeats();
    }

    private void generateSeats() {

        // Courtside / Premium
        for (int i = 1; i <= 5; i++) {
            seats.add(new SportsSeat(
                    "VIP-" + i,
                    "VIP / Courtside",
                    500.00
            ));
        }

        // Lower Level
        for (int i = 1; i <= 10; i++) {
            seats.add(new SportsSeat(
                    "LOW-" + i,
                    "Lower Level",
                    250.00
            ));
        }

        // Club Level
        for (int i = 1; i <= 10; i++) {
            seats.add(new SportsSeat(
                    "CLUB-" + i,
                    "Club Level",
                    175.00
            ));
        }

        // Upper Level
        for (int i = 1; i <= 15; i++) {
            seats.add(new SportsSeat(
                    "UP-" + i,
                    "Upper Level",
                    75.00
            ));
        }
    }

    public String getGameId() {
        return gameId;
    }

    public Team getHomeTeam() {
        return homeTeam;
    }

    public Team getAwayTeam() {
        return awayTeam;
    }

    public SportsVenue getVenue() {
        return venue;
    }

    public List<SportsSeat> getSeats() {
        return seats;
    }

    public String getDate() {
        return date;
    }

    public String getTime() {
        return time;
    }

    public void displayGame() {
        System.out.println("\n--------------------------------");
        System.out.println("Game ID: " + gameId);
        System.out.println(
                awayTeam.getFullName() +
                " @ " +
                homeTeam.getFullName()
        );
        System.out.println("Sport: " + homeTeam.getSport());
        System.out.println("League: " + homeTeam.getLeague());
        System.out.println("Venue: " + venue.getName());
        System.out.println("Location: " + venue.getCity());
        System.out.println("Date: " + date);
        System.out.println("Time: " + time);
        System.out.println("--------------------------------");
    }
}


// =====================================================
// SPORTS SEAT
// =====================================================
class SportsSeat {

    private String seatNumber;
    private String section;
    private double price;
    private boolean available;

    public SportsSeat(String seatNumber,
                      String section,
                      double price) {

        this.seatNumber = seatNumber;
        this.section = section;
        this.price = price;
        this.available = true;
    }

    public String getSeatNumber() {
        return seatNumber;
    }

    public String getSection() {
        return section;
    }

    public double getPrice() {
        return price;
    }

    public boolean isAvailable() {
        return available;
    }

    public boolean reserve() {

        if (available) {
            available = false;
            return true;
        }

        return false;
    }

    public void cancelReservation() {
        available = true;
    }

    public void displaySeat() {

        System.out.printf(
                "%-10s | %-18s | $%-7.2f | %s%n",
                seatNumber,
                section,
                price,
                available ? "AVAILABLE" : "RESERVED"
        );
    }
}



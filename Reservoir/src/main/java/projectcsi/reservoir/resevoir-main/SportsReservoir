    public SportsGame findGame(String gameId) {

        for (SportsGame game : games) {

            if (game.getGameId()
                    .equalsIgnoreCase(gameId)) {

                return game;
            }
        }

        return null;
    }


    // -------------------------------------------------
    // DISPLAY SEATS
    // -------------------------------------------------
    public void displayAvailableSeats(
            SportsGame game) {

        System.out.println(
                "\n========== AVAILABLE SEATS =========="
        );

        for (SportsSeat seat : game.getSeats()) {

            if (seat.isAvailable()) {
                seat.displaySeat();
            }
        }
    }


    // -------------------------------------------------
    // FIND SEAT
    // -------------------------------------------------
    public SportsSeat findSeat(
            SportsGame game,
            String seatNumber) {

        for (SportsSeat seat : game.getSeats()) {

            if (seat.getSeatNumber()
                    .equalsIgnoreCase(seatNumber)) {

                return seat;
            }
        }

        return null;
    }


    // -------------------------------------------------
    // CREATE RESERVATION
    // -------------------------------------------------
    public SportsReservation createReservation(
            SportsCustomer customer,
            SportsGame game,
            SportsSeat seat) {

        if (seat == null || !seat.reserve()) {
            return null;
        }

        String reservationId =
                "SR" + (reservations.size() + 1001);

        SportsReservation reservation =
                new SportsReservation(
                        reservationId,
                        customer,
                        game,
                        seat
                );

        reservations.add(reservation);

        return reservation;
    }


    // -------------------------------------------------
    // VIEW CUSTOMER RESERVATIONS
    // -------------------------------------------------
    public void viewReservations(
            SportsCustomer customer) {

        boolean found = false;

        System.out.println(
                "\n========== MY SPORTS TICKETS =========="
        );

        for (SportsReservation reservation : reservations) {

            if (reservation
                    .getCustomer()
                    .getCustomerId()
                    .equals(customer.getCustomerId())) {

                reservation.displayTicket();
                found = true;
            }
        }

        if (!found) {
            System.out.println(
                    "You currently have no sports reservations."
            );
        }
    }


    // -------------------------------------------------
    // CANCEL RESERVATION
    // -------------------------------------------------
    public boolean cancelReservation(
            String reservationId) {

        for (SportsReservation reservation : reservations) {

            if (reservation
                    .getReservationId()
                    .equalsIgnoreCase(reservationId)) {

                if (reservation.isActive()) {

                    reservation.cancel();

                    return true;
                }
            }
        }

        return false;
    }
}


// =====================================================
// MAIN RESERVO SPORTS APPLICATION
// =====================================================
public class ReservoSports {

    public static void main(String[] args) {

        Scanner scanner = new Scanner(System.in);

        SportsReservationSystem system =
                new SportsReservationSystem();

        System.out.println();
        System.out.println("=========================================");
        System.out.println("       WELCOME TO RESERVO SPORTS");
        System.out.println("=========================================");

        System.out.println("\nCreate your customer profile.");

        System.out.print("Name: ");
        String name = scanner.nextLine();

        System.out.print("Email: ");
        String email = scanner.nextLine();

        SportsCustomer customer =
                new SportsCustomer(
                        "USER001",
                        name,
                        email
                );

        boolean running = true;

        while (running) {

            System.out.println();
            System.out.println("=========================================");
            System.out.println("              MAIN MENU");
            System.out.println("=========================================");
            System.out.println("1. View All Sports Teams");
            System.out.println("2. View Available Games");
            System.out.println("3. Search Games by Sport");
            System.out.println("4. Search Games by Team");
            System.out.println("5. Reserve Tickets");
            System.out.println("6. View My Reservations");
            System.out.println("7. Cancel Reservation");
            System.out.println("8. Exit");

            System.out.print("\nChoose an option: ");

            String option = scanner.nextLine();

            switch (option) {

                // -------------------------------------
                // VIEW TEAMS
                // -------------------------------------
                case "1":

                    system.displayTeams();

                    break;


                // -------------------------------------
                // VIEW GAMES
                // -------------------------------------
                case "2":

                    system.displayGames();

                    break;


                // -------------------------------------
                // SEARCH SPORT
                // -------------------------------------
                case "3":

                    System.out.print(
                            "\nEnter sport " +
                            "(Basketball, Football, Baseball, Hockey): "
                    );

                    String sport = scanner.nextLine();

                    system.searchBySport(sport);

                    break;


                // -------------------------------------
                // SEARCH TEAM
                // -------------------------------------
                case "4":

                    System.out.print(
                            "\nEnter team name: "
                    );

                    String teamName = scanner.nextLine();

                    system.searchByTeam(teamName);

                    break;


                // -------------------------------------
                // RESERVE TICKET
                // -------------------------------------
                case "5":

                    system.displayGames();

                    System.out.print(
                            "\nEnter Game ID: "
                    );

                    String gameId = scanner.nextLine();

                    SportsGame selectedGame =
                            system.findGame(gameId);

                    if (selectedGame == null) {

                        System.out.println(
                                "Game not found."
                        );

                        break;
                    }

                    selectedGame.displayGame();

                    system.displayAvailableSeats(
                            selectedGame
                    );

                    System.out.print(
                            "\nEnter Seat Number: "
                    );

                    String seatNumber =
                            scanner.nextLine();

                    SportsSeat selectedSeat =
                            system.findSeat(
                                    selectedGame,
                                    seatNumber
                            );

                    if (selectedSeat == null) {

                        System.out.println(
                                "Seat does not exist."
                        );

                        break;
                    }

                    SportsReservation reservation =
                            system.createReservation(
                                    customer,
                                    selectedGame,
                                    selectedSeat
                            );

                    if (reservation != null) {

                        System.out.println();
                        System.out.println(
                                "RESERVATION SUCCESSFUL!"
                        );

                        reservation.displayTicket();

                    } else {

                        System.out.println(
                                "That seat is already reserved."
                        );
                    }

                    break;


                // -------------------------------------
                // VIEW RESERVATIONS
                // -------------------------------------
                case "6":

                    system.viewReservations(customer);

                    break;


                // -------------------------------------
                // CANCEL RESERVATION
                // -------------------------------------
                case "7":

                    System.out.print(
                            "\nEnter Reservation ID: "
                    );

                    String reservationId =
                            scanner.nextLine();

                    boolean cancelled =
                            system.cancelReservation(
                                    reservationId
                            );

                    if (cancelled) {

                        System.out.println(
                                "Reservation cancelled successfully."
                        );

                    } else {

                        System.out.println(
                                "Reservation could not be found " +
                                "or was already cancelled."
                        );
                    }

                    break;


                // -------------------------------------
                // EXIT
                // -------------------------------------
                case "8":

                    running = false;

                    System.out.println(
                            "\nThank you for using Reservo Sports!"
                    );

                    break;


                default:

                    System.out.println(
                            "Invalid option. Please try again."
                    );
            }
        }

        scanner.close();
    }
}

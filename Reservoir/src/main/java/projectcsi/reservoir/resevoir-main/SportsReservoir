    // -------------------------------------------------
    // SEARCH BY SPORT
    // -------------------------------------------------
    public void searchBySport(String sport) {

        boolean found = false;

        System.out.println(
                "\nGames for sport: " + sport
        );

        for (SportsGame game : games) {

            if (game.getHomeTeam()
                    .getSport()
                    .equalsIgnoreCase(sport)) {

                game.displayGame();
                found = true;
            }
        }

        if (!found) {
            System.out.println(
                    "No games found for that sport."
            );
        }
    }


    // -------------------------------------------------
    // SEARCH BY TEAM
    // -------------------------------------------------
    public void searchByTeam(String teamName) {

        boolean found = false;

        for (SportsGame game : games) {

            if (game.getHomeTeam()
                    .getFullName()
                    .toLowerCase()
                    .contains(teamName.toLowerCase())

                    ||

                    game.getAwayTeam()
                    .getFullName()
                    .toLowerCase()
                    .contains(teamName.toLowerCase())) {

                game.displayGame();
                found = true;
            }
        }

        if (!found) {
            System.out.println(
                    "No games found for " + teamName
            );
        }
    }


    // -------------------------------------------------

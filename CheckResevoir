package projectcsi.reservoir;

import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;

import javafx.geometry.Insets;
import javafx.geometry.Pos;
import javafx.scene.Scene;
import javafx.scene.control.*;
import javafx.scene.layout.*;
import javafx.stage.Stage;

public class CreateEventScreen {

    private final Stage stage;
    private final java.util.ArrayList<Event> events;
    private final Runnable backToDashboard;
    private final String hostEmail;

    public CreateEventScreen(
            Stage stage,
            java.util.ArrayList<Event> events,
            String hostEmail,
            Runnable backToDashboard) {

        this.stage = stage;
        this.events = events;
        this.hostEmail = hostEmail;
        this.backToDashboard = backToDashboard;
    }

    // ============================================
    // CHECK HOST PAYMENT METHOD IN DATABASE
    // ============================================

    public static boolean hasCardOnFile(String email) {

        if (email == null || email.isBlank()) {
            return false;
        }

        String dbURL = System.getenv("RESERVOIR_DB_URL");
        String dbUser = System.getenv("RESERVOIR_DB_USER");
        String dbPassword =
                System.getenv("RESERVOIR_DB_PASSWORD");

        if (dbURL == null || dbURL.isBlank()) {
            throw new IllegalStateException(
                "Database connection is not configured.");
        }

        // IMPORTANT:
        // Match card_number to your teammate's
        // actual database column name.

        String sql =
                "SELECT 1 FROM customers "
                + "WHERE email = ? "
                + "AND card_number IS NOT NULL "
                + "AND TRIM(card_number) <> '' "
                + "LIMIT 1";

        try (
            Connection connection =
                    DriverManager.getConnection(
                            dbURL, dbUser, dbPassword);

            PreparedStatement statement =
                    connection.prepareStatement(sql)
        ) {

            statement.setString(1, email.trim());

            try (ResultSet result =
                    statement.executeQuery()) {

                return result.next();
            }

        } catch (SQLException ex) {

            throw new IllegalStateException(
                    "Unable to verify host payment method.",
                    ex);
        }
    }

    // ============================================
    // SHOW CREATE EVENT SCREEN
    // ============================================

    public void show() {

        // VERIFY CARD BEFORE DISPLAYING FORM

        try {

            if (!hasCardOnFile(hostEmail)) {

                Alert warning = new Alert(
                        Alert.AlertType.WARNING);

                warning.setTitle("Payment Required");
                warning.setHeaderText(
                        "Payment Method Missing");

                warning.setContentText(
                        "You must add a payment method "
                        + "in your Account before "
                        + "hosting an event.");

                warning.showAndWait();

                backToDashboard.run();
                return;
            }

        } catch (IllegalStateException ex) {

            showError(
                    "Payment verification unavailable. "
                    + "Please check the database connection.");

            backToDashboard.run();
            return;
        }

        Label titleLabel =
                new Label("CREATE EVENT");

        titleLabel.setStyle(
                "-fx-font-size: 30px;"
                + "-fx-font-weight: bold;");

        Label subtitleLabel = new Label(
                "Host your event with Reservoir");

        Label verifiedLabel = new Label(
                "Payment method on file (demo check)");

        verifiedLabel.setStyle(
                "-fx-text-fill: green;"
                + "-fx-font-weight: bold;");

        // EVENT NAME

        Label eventNameLabel =
                new Label("Event Name");

        TextField eventNameField =
                new TextField();

        eventNameField.setPromptText(
                "Enter event name");

        eventNameField.setMaxWidth(350);

        // DESCRIPTION

        Label descriptionLabel =
                new Label("Description");

        TextArea descriptionArea =
                new TextArea();

        descriptionArea.setPromptText(
                "Enter event description");

        descriptionArea.setMaxWidth(350);
        descriptionArea.setPrefHeight(80);
        descriptionArea.setWrapText(true);

        // LOCATION

        Label locationLabel =
                new Label("Location");

        TextField locationField =
                new TextField();

        locationField.setPromptText(
                "Enter or search for an address");

        locationField.setMaxWidth(350);

        PhotonAddressAutocomplete autocomplete =
                new PhotonAddressAutocomplete(
                        locationField);

        Button selectLocationButton =
                new Button("Select Location");

        selectLocationButton.setOnAction(action -> {

            LocationPicker picker =
                    new LocationPicker(
                            stage,
                            selectedAddress -> {
                                locationField.setText(
                                        selectedAddress);
                            });

            picker.show();
        });

        HBox locationRow = new HBox(
                10,
                locationField,
                selectLocationButton);

        locationRow.setAlignment(Pos.CENTER);

        // DATE

        Label dateLabel = new Label("Date");

        DatePicker datePicker =
                new DatePicker();

        datePicker.setPromptText(
                "Choose a date");

        datePicker.setPrefWidth(350);

        // TIME

        Label timeLabel = new Label("Time");

        TextField timeField =
                new TextField();

        timeField.setPromptText(
                "Example: 7:00 PM");

        timeField.setMaxWidth(350);

        // CAPACITY

        Label capacityLabel =
                new Label("How Many People");

        TextField capacityField =
                new TextField();

        capacityField.setPromptText(
                "Enter number of people");

        capacityField.setMaxWidth(350);

        // PRICE

        Label priceLabel =
                new Label("Cost Per Ticket");

        TextField priceField =
                new TextField();

        priceField.setPromptText(
                "Example: 25.00");

        priceField.setMaxWidth(350);

        // STATUS

        Label messageLabel = new Label();
        messageLabel.setWrapText(true);

        // BUTTONS

        Button createButton =
                new Button("Create Event");

        createButton.setPrefSize(250, 40);

        Button backButton =
                new Button("Back to Dashboard");

        backButton.setPrefSize(250, 40);

        // ========================================
        // CREATE EVENT ACTION
        // ========================================

        createButton.setOnAction(action -> {

            String eventName =
                    eventNameField.getText().trim();

            String description =
                    descriptionArea.getText().trim();

            String location =
                    locationField.getText().trim();

            String time =
                    timeField.getText().trim();

            String capacityText =
                    capacityField.getText().trim();

            String priceText =
                    priceField.getText().trim();

            // VALIDATE FIELDS

            if (eventName.isEmpty()
                    || description.isEmpty()
                    || location.isEmpty()
                    || datePicker.getValue() == null
                    || time.isEmpty()
                    || capacityText.isEmpty()
                    || priceText.isEmpty()) {

                messageLabel.setText(
                        "Please complete all fields.");

                return;
            }

            try {

                int capacity =
                        Integer.parseInt(capacityText);

                double price =
                        Double.parseDouble(priceText);

                if (capacity <= 0) {

                    messageLabel.setText(
                            "Capacity must be greater than zero.");

                    return;
                }

                if (!Double.isFinite(price)
                        || price < 0) {

                    messageLabel.setText(
                            "Enter a valid nonnegative price.");

                    return;
                }

                // =================================
                // VERIFY PAYMENT METHOD AGAIN
                // =================================

                if (!hasCardOnFile(hostEmail)) {

                    messageLabel.setText(
                            "Event creation blocked. "
                            + "Please add a payment method "
                            + "to your Account.");

                    return;
                }

                String date =
                        datePicker.getValue().toString();

                // GET OPTIONAL MAP COORDINATES

                PhotonAddressAutocomplete.AddressSuggestion
                        suggestion =
                        autocomplete.getSelectedSuggestion();

                if (suggestion != null) {

                    System.out.println(
                            "Latitude: "
                            + suggestion.latitude());

                    System.out.println(
                            "Longitude: "
                            + suggestion.longitude());
                }

                // =================================
                // CREATE AND SAVE EVENT
                // =================================

                Event newEvent = new Event(
                        eventName,
                        description,
                        location,
                        date,
                        time,
                        capacity,
                        price
                );

                events.add(newEvent);

                messageLabel.setText(
                        "Event created successfully!");

                Alert success = new Alert(
                        Alert.AlertType.INFORMATION);

                success.setTitle("Success");

                success.setHeaderText(
                        "Event Created!");

                success.setContentText(
                        eventName
                        + " has been added to Reservoir.");

                success.showAndWait();

                // CLEAR FIELDS

                eventNameField.clear();
                descriptionArea.clear();
                locationField.clear();
                datePicker.setValue(null);
                timeField.clear();
                capacityField.clear();
                priceField.clear();

            } catch (NumberFormatException ex) {

                messageLabel.setText(
                        "Capacity and cost must be numbers.");

            } catch (IllegalStateException ex) {

                messageLabel.setText(
                        "Unable to verify payment method. "
                        + "Event was not created.");
            }
        });

        backButton.setOnAction(
                action -> backToDashboard.run());

        // ========================================
        // PAGE LAYOUT
        // ========================================

        VBox layout = new VBox(
                10,
                titleLabel,
                subtitleLabel,
                verifiedLabel,
                eventNameLabel,
                eventNameField,
                descriptionLabel,
                descriptionArea,
                locationLabel,
                locationRow,
                dateLabel,
                datePicker,
                timeLabel,
                timeField,
                capacityLabel,
                capacityField,
                priceLabel,
                priceField,
                createButton,
                messageLabel,
                backButton
        );

        layout.setAlignment(Pos.CENTER);
        layout.setPadding(new Insets(25));

        ScrollPane scroll =
                new ScrollPane(layout);

        scroll.setFitToWidth(true);

        stage.setScene(
                new Scene(scroll, 900, 700));
    }

    private void showError(String message) {

        Alert alert = new Alert(
                Alert.AlertType.ERROR);

        alert.setTitle("Reservoir Error");
        alert.setHeaderText("Unable to Continue");
        alert.setContentText(message);

        alert.showAndWait();
    }
}
